diff --git a/lib/group-send-limiter.js b/lib/group-send-limiter.js
new file mode 100644
index 0000000..7753bf6
--- /dev/null
+++ b/lib/group-send-limiter.js
@@ -0,0 +1,92 @@
+/** Physical group-send attempts, shared by passive replies and every tool.
+ * Slots are reserved synchronously before the transport can yield. No queue. */
+import {readFileSync, writeFileSync, mkdirSync, renameSync, statSync} from 'node:fs';
+import {dirname} from 'node:path';
+
+const HOUR_MS = 3_600_000;
+const MAX_GROUPS = 512;
+const MAX_HOURLY_ATTEMPTS = 1000;
+export class GroupSendRateLimitError extends Error {
+    constructor(reason) {
+        super(reason + '；本次未发送，请勿重试或补发。');
+        this.name = 'GroupSendRateLimitError';
+        this.code = 'GROUP_SEND_RATE_LIMIT';
+    }
+}
+
+function limit(value, fallback, maximum) {
+    return Number.isInteger(value) && value > 0 ? Math.min(value, maximum) : fallback;
+}
+
+export class GroupSendLimiter {
+    constructor({perMinute, perHour, now = () => Date.now(), statePath, onError = () => {}} = {}) {
+        this.perMinute = limit(perMinute, 6, 100);
+        this.perHour = limit(perHour, 40, MAX_HOURLY_ATTEMPTS);
+        this.now = now;
+        this.statePath = statePath;
+        this.onError = onError;
+        this.groups = new Map();
+        this.blockedUntil = 0;
+        if (statePath) {
+            try {
+                if (statSync(statePath).size > 8 * 1024 * 1024) throw Error('group-send state is too large');
+                const saved = JSON.parse(readFileSync(statePath, 'utf8'));
+                if (saved.version !== 1 || !Array.isArray(saved.groups) || saved.groups.length > MAX_GROUPS)
+                    throw Error('invalid group-send state');
+                for (const row of saved.groups) {
+                    if (!Array.isArray(row) || row.length !== 2 || typeof row[0] !== 'string' || !/^[1-9][0-9]{0,19}$/.test(row[0]) || this.groups.has(row[0]) || !Array.isArray(row[1]) || row[1].length > MAX_HOURLY_ATTEMPTS || row[1].some(time => !Number.isFinite(time)))
+                        throw Error('invalid group-send record');
+                    this.groups.set(row[0], row[1]);
+                }
+            }
+            catch (error) {
+                this.groups.clear();
+                if (error.code !== 'ENOENT') {
+                    // Unknown previous usage must never become a fresh quota.
+                    this.blockedUntil = this.now() + HOUR_MS;
+                    this.onError(error);
+                }
+            }
+        }
+    }
+    async call(action, params, physicalCall, chatId) {
+        if (!action.startsWith('send_') && action !== 'upload_group_file')
+            return physicalCall();
+        if (action.startsWith('send_private_') || action === 'upload_private_file')
+            return physicalCall();
+        const group = params.group_id ?? (params.user_id == null && chatId?.startsWith('group:') ? chatId.slice(6) : undefined);
+        if (group == null && !action.startsWith('send_group_') && params.message_type !== 'group')
+            return physicalCall();
+        if (!/^[0-9]{1,20}$/.test(String(group)) || BigInt(group) <= 0n)
+            throw new GroupSendRateLimitError('无效群号');
+        const id = String(BigInt(group));
+        const now = this.now();
+        if (now < this.blockedUntil)
+            throw new GroupSendRateLimitError('群聊发送记录不可读，暂缓发送');
+        for (const [key, times] of this.groups) {
+            const active = times.filter(time => now - time < HOUR_MS);
+            if (active.length) this.groups.set(key, active);
+            else this.groups.delete(key);
+        }
+        const times = this.groups.get(id) ?? [];
+        if (times.length >= this.perHour || times.filter(time => now - time < 60_000).length >= this.perMinute)
+            throw new GroupSendRateLimitError('群聊发送频率已达本地上限');
+        if (!this.groups.has(id) && this.groups.size >= MAX_GROUPS)
+            throw new GroupSendRateLimitError('群聊发送记录已达容量上限');
+        times.push(now);
+        this.groups.set(id, times);
+        if (this.statePath) {
+            try {
+                mkdirSync(dirname(this.statePath), {recursive: true});
+                const temp = this.statePath + '.tmp';
+                writeFileSync(temp, JSON.stringify({version: 1, groups: [...this.groups]}), {flush: true});
+                renameSync(temp, this.statePath);
+            }
+            catch (error) {
+                this.onError(error);
+                throw new GroupSendRateLimitError('群聊发送记录无法保存');
+            }
+        }
+        return physicalCall();
+    }
+}
